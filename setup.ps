# printer-manager.ps1

Clear-Host

function Show-Menu {

    Write-Host ""
    Write-Host "========================================"
    Write-Host "      SCHOOL PRINTER MANAGER"
    Write-Host "========================================"
    Write-Host ""
    Write-Host "1. Share Printer (Server)"
    Write-Host "2. Connect Printer (Client)"
    Write-Host "3. List Installed Printers"
    Write-Host "4. Set Default Printer"
    Write-Host "5. Remove Network Printer"
    Write-Host "0. Exit"
    Write-Host ""
}

do {

    Show-Menu

    $choice = Read-Host "Pilih Menu"

    switch ($choice) {

        "1" {

            $printers = Get-Printer

            Write-Host ""
            Write-Host "Printer ditemukan:"
            Write-Host ""

            for ($i=0; $i -lt $printers.Count; $i++) {
                Write-Host "$($i+1). $($printers[$i].Name)"
            }

            $selected = Read-Host "Pilih nomor printer"

            $printer = $printers[$selected-1]

            $shareName = Read-Host "Nama Share"

            if ([string]::IsNullOrWhiteSpace($shareName)) {
                $shareName = "PRINTER_SEKOLAH"
            }

            netsh advfirewall firewall set rule group="File and Printer Sharing" new enable=Yes | Out-Null

            Set-Printer `
                -Name $printer.Name `
                -Shared $true `
                -ShareName $shareName

            Write-Host ""
            Write-Host "BERHASIL"
            Write-Host "\\$env:COMPUTERNAME\$shareName"
        }

        "2" {

            $server = Read-Host "IP / Nama Server"

            $share = Read-Host "Nama Share"

            Add-Printer `
                -ConnectionName "\\$server\$share"

            Write-Host ""
            Write-Host "Printer berhasil ditambahkan"
        }

        "3" {

            Get-Printer |
            Format-Table Name,Shared,Type
        }

        "4" {

            $printers = Get-Printer

            for ($i=0; $i -lt $printers.Count; $i++) {
                Write-Host "$($i+1). $($printers[$i].Name)"
            }

            $selected = Read-Host "Pilih"

            Set-Printer `
                -Name $printers[$selected-1].Name `
                -IsDefault $true

            Write-Host "Default printer diubah"
        }

        "5" {

            $printers = Get-Printer

            for ($i=0; $i -lt $printers.Count; $i++) {
                Write-Host "$($i+1). $($printers[$i].Name)"
            }

            $selected = Read-Host "Pilih"

            Remove-Printer `
                -Name $printers[$selected-1].Name

            Write-Host "Printer dihapus"
        }

        "0" {
            break
        }
    }

} while ($true)